{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Audax Data Manager",
  "version": "1.6.2",
  "identifier": "com.commandprompt.audaxdm",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "splash",
        "url": "splash.html",
        "title": "Audax Data Manager",
        "width": 600,
        "height": 280,
        "decorations": false,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
