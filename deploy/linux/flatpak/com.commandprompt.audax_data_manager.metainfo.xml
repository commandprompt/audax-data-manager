<component type="desktop-application">
  <id>com.commandprompt.audax_data_manager</id>

  <name>Audax Data Manager</name>
  <summary>Query and manage SQL databases</summary>

  <developer id="com.commandprompt">
    <name>Command Prompt, Inc.</name>
  </developer>

  <recommends>
    <display_length compare="ge">768</display_length>
  </recommends>

  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>

  <description>
    <p>
      Audax Data Manager is a free, open-source database client and administration tool
      for PostgreSQL, MySQL, MariaDB, SQL Server, SQLite and Oracle. One app for all of
      these databases, with no tracking and no telemetry.
    </p>
    <ul>
      <li>Connect to many databases at the same time in tabbed workspaces</li>
      <li>SQL editor with syntax highlighting and schema-aware autocomplete</li>
      <li>Visual query plans and a spreadsheet-like results grid</li>
      <li>Visual editors for data and table structure</li>
      <li>Entity relationship diagrams</li>
      <li>Live monitoring and PostgreSQL configuration management</li>
      <li>PostgreSQL backup and restore that run in the background</li>
      <li>Credentials encrypted with a master password, SSH tunnels and a built-in SSH terminal</li>
      <li>Dark and light themes</li>
    </ul>
  </description>

  <launchable type="desktop-id">com.commandprompt.audax_data_manager.desktop</launchable>

